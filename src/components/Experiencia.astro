---
import ExperienciaItem from '../components/ExperienciaItem.astro'

const EXPERIENCIA = [
    {
        "date": "Mayo 2023",
        "title": "Desarrollo Móvil",
        "description": "En el desarrollo de una aplicación móvil, trabajé en un proyecto de una aplicación de podcast para una empresa de multimedios. Utilicé React Native para obtener una aplicación multiplataforma, creando una interfaz intuitiva que permitía a los usuarios encontrar y reproducir sus programas favoritos. Realicé pruebas exhaustivas para asegurar la compatibilidad con diferentes versiones de sistemas operativos y dispositivos, garantizando una experiencia de usuario fluida y sin errores."
    },
    {
        "date": "Diciembre 2023",
        "title": "Desarrollo para Desktop",
        "description": "En el desarrollo de una aplicación de escritorio, trabajé en un software de gestión de un inventario o punto de venta. Utilicé Java y el entorno de desarrollo Apache NetBeans para crear una interfaz de usuario funcional. La aplicación permitía gestionar productos, asignar recursos y generar informes detallados sobre los movimientos realizados en cada venta."
    },
    {
        "date": "Enero 2025",
        "title": "Desarrollo de Aplicación Web",
        "description": "Participé en el desarrollo del proyecto \"Sistema de gestión de contenidos de Estados de Fuerza para la Coordinación de la Policía de Investigación de la Fiscalía General del Estado de Michoacán\" en el cual se desarrolló una plataforma de administración de Estados de Fuerza. Esta plataforma permitía registrar, almacenar y actualizar la información en tiempo real, mejorando la asignación y uso de recursos mediante datos precisos y actualizados."
    }
]
---

<ol class="relative border-s border-gray-200">     
    {
        EXPERIENCIA.map((experiencia) =>(
        <li class="mb-10 ms-4">
            <ExperienciaItem {... experiencia} />
        </li>
        ))
    }             
    
</ol>